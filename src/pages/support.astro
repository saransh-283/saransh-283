---
import Layout from '@layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { supportMethods } from '@data/support';

const links = supportMethods.filter((m) => m.kind === 'link');
const wallets = supportMethods.filter((m) => m.kind === 'address');

const marqueePhrases = [
	'building in public',
	'root causes over band-aids',
	'tools stay free forever',
	'servers stay warm',
	'docs nobody has to reverse-engineer',
	'one tip = one experiment',
];

const iconFor: Record<string, string> = {
	payu: 'mdi:paypal',
	paypal: 'mdi:paypal',
	sol: 'simple-icons:solana',
	eth: 'mdi:ethereum',
	btc: 'mdi:bitcoin',
};
---

<Layout
	title="Saransh — leave a tip"
	description="If my work saved you time or made you smile, you can support me: PayU for India (UPI/cards), PayPal internationally, or SOL/ETH/BTC wallets. No pressure — every bit helps."
>
	<main class="mx-auto max-w-2xl">
		<header class="pt-4 reveal">
			<div class="flex justify-center">
				<div class="h-12 w-12 animate-float text-primary">
					<Icon name="mdi:heart" class="h-12 w-12" />
				</div>
			</div>
			<h1 class="mt-3 text-center text-4xl font-extrabold tracking-tight text-ink">Support me</h1>
			<p class="mx-auto mt-3 max-w-lg text-center text-sm leading-6 text-neutral-500">
				Everything here is free &mdash; no paywalls, no locked features. But if something I built saved you time or made you grin, a small tip keeps the servers humming and the ideas compiling.
			</p>
		</header>

		<section class="mt-10 reveal">
			<h2 class="text-base font-bold text-ink">Pay links</h2>
			<p class="mt-1 text-sm text-neutral-500">One click, done deal</p>
			<div class="mt-4 grid gap-3">
				{links.map((method) => (
					<a
						href={method.href}
						target="_blank"
						rel="noopener"
						class="group card-lift flex items-center gap-4 rounded-xl bg-neutral-50 p-4 ring-1 ring-soft transition hover:bg-white hover:ring-primary/30"
					>
						<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white text-ink ring-1 ring-soft transition group-hover:text-deep">
							<Icon name={iconFor[method.id]} class="h-5 w-5" />
						</span>
						<span class="min-w-0">
							<span class="block font-semibold text-ink">{method.label}</span>
							<span class="block text-xs text-neutral-500">{method.note}</span>
						</span>
						<span class="ml-auto font-monospace text-xs text-neutral-400 transition group-hover:text-deep" aria-hidden="true">&rarr;</span>
					</a>
				))}
			</div>
		</section>

		<section class="mt-10 reveal">
			<h2 class="text-base font-bold text-ink">Crypto</h2>
			<p class="mt-1 text-sm text-neutral-500">Click to copy &mdash; and thank you, satoshi bless</p>
			<div class="mt-4 grid gap-3">
				{wallets.map((method) => {
					return (
						<div class="group flex items-center gap-4 rounded-xl bg-neutral-50 p-4 ring-1 ring-soft transition hover:bg-white hover:ring-primary/30">
							<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white text-ink ring-1 ring-soft">
								<Icon name={iconFor[method.id]} class="h-5 w-5" />
							</span>
							<span class="min-w-0 flex-1">
								<span class="block font-semibold text-ink">{method.label}</span>
								<span class="block truncate font-monospace text-xs text-neutral-500" data-testid={`address-${method.id}`}>{method.address}</span>
							</span>
							<button type="button" class="copy-btn shrink-0 rounded-lg bg-white p-2 text-neutral-500 ring-1 ring-soft transition hover:text-deep active:scale-90" data-address={method.address} aria-label={`Copy ${method.label} address`}>
								<Icon name="mdi:content-copy" class="h-4 w-4" />
							</button>
						</div>
					);
				})}
			</div>
		</section>

		<section class="mt-12 reveal" aria-hidden="true">
			<div class="mx-auto max-w-xl overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_12%,black_88%,transparent)]">
				<div class="flex w-max animate-marquee gap-8 py-1 font-monospace text-xs text-neutral-400">
					{[...marqueePhrases, ...marqueePhrases].map((phrase) => (
						<span class="whitespace-nowrap">{phrase} <span class="text-primary">&horbar;</span></span>
					))}
				</div>
			</div>
		</section>

		<section class="mt-8 pb-4 text-center reveal">
			<p class="text-sm text-neutral-500">
				Every rupee, dollar, and wei goes straight back into better tools, faster servers, and more experiments.
			</p>
			<p class="mt-2 font-monospace text-xs text-neutral-400">$ exit 0 &mdash; thanks for being here &hearts;</p>
		</section>
	</main>
</Layout>

<script>
	document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
		btn.addEventListener('click', async () => {
			const address = btn.dataset.address;
			if (!address) return;

			try {
				await navigator.clipboard.writeText(address);
			} catch {
				const ta = document.createElement('textarea');
				ta.value = address;
				document.body.appendChild(ta);
				ta.select();
				document.execCommand('copy');
				ta.remove();
			}

			btn.setAttribute('data-copied', 'true');
			let hint = btn.querySelector('.copied-hint');
			if (!hint) {
				hint = document.createElement('span');
				hint.className = 'copied-hint';
				hint.textContent = ' ✓';
				btn.appendChild(hint);
			}
			setTimeout(() => {
				btn.removeAttribute('data-copied');
				hint?.remove();
			}, 1500);
		});
	});
</script>
