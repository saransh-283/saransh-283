---
import Layout from "@layouts/Layout.astro";
import ProjectRow from "@components/projects/ProjectRow.astro";
import { getCollection } from "astro:content";
import { Icon } from 'astro-icon/components';

const projects = await getCollection("projects");
---

<Layout
	title="Saransh — things I've built"
	description="Projects by Saransh Kawadkar — 3D reconstruction tooling, a Solana banking prototype, procedural RPG engines in C++, and UI systems that read like products."
>
  <main class="mx-auto max-w-3xl">
    <header class="pt-4 reveal">
      <div class="flex gap-6 justify-center items-center">
        <div class="h-12 w-12 text-primary">
          <Icon name="mdi:briefcase" class="h-12 w-12" />
        </div>
      </div>
      <h1 class="mt-3 text-center text-4xl font-extrabold tracking-tight text-ink">Things I've built</h1>
      <p class="mx-auto mt-3 max-w-xl text-center text-sm leading-6 text-neutral-500">An honest pile of experiments, tools, and the occasional serious system &mdash; each one taught me something.</p>
    </header>

    <section class="mt-10 space-y-8">
      {projects.map((project, i) => <ProjectRow title={project.data.title} description={project.data.description} href={`/projects/${project.slug}`} thumbnail={project.data.thumbnail} tags={project.data.tags} inProgress={project.data.inProgress} delay={0.08 * (i + 1)} />)}
    </section>
  </main>
</Layout>
