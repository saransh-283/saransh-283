---
import Tag from '@components/ui/Tag.astro';
import Terminal from '@components/ui/Terminal.astro';
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const services = await getCollection('services');
	return services.map((service) => ({
		params: { slug: service.slug },
		props: { service },
	}));
}

const { service } = Astro.props;

const terminalLines = [
	{ kind: 'cmd', text: `service-info --name "${service.data.title}"` },
	{ kind: 'out', text: 'status: available · response < 48h' },
	{ kind: 'cmd', text: 'cat ~/what-that-looks-like' },
	...(service.data.typicalWork ?? []).map((item: string) => ({ kind: 'out', text: item })),
	...(service.data.deliverables ?? []).length > 0 ? [{ kind: 'cmd', text: 'cat ~/what-you-get' }] : [],
	...(service.data.deliverables ?? []).map((item: string) => ({ kind: 'out', text: `[x] ${item}` })),
	{ kind: 'cmd', text: '' },
];

const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: service.data.title,
	description: service.data.summary,
	url: new URL(`/services/${service.slug}`, Astro.site).href,
	keywords: service.data.tags.join(', '),
	provider: { '@type': 'Person', name: 'Saransh Kawadkar', url: Astro.site?.href },
	areaServed: 'Worldwide',
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

<Layout
	title={`Saransh — ${service.data.title}`}
	description={service.data.summary}
	type="article"
>
	<main class="mx-auto max-w-3xl">
		<header class="pt-4 reveal">
			<p class="font-monospace text-sm text-primary" aria-hidden="true">// service #${service.data.order}</p>
			<h1 class="mt-2 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">{service.data.title}</h1>
			<p class="mt-3 text-sm leading-6 text-neutral-500">{service.data.summary}</p>
			<Terminal lines={terminalLines} cursor class="mx-auto mt-6 w-full max-w-xl animate-fade-up" />
		</header>

		<section class="mt-10 reveal">
			<h2 class="text-base font-bold text-ink"><span class="mr-2 font-monospace text-xs text-primary">01</span>What I do here</h2>
			<p class="mt-2 text-sm leading-6 text-neutral-500">{service.data.what}</p>
		</section>

		{service.data.focus?.length > 0 && (
			<section class="mt-10 reveal">
				<h2 class="text-base font-bold text-ink"><span class="mr-2 font-monospace text-xs text-primary">02</span>Where I focus</h2>
				<ul class="mt-2 space-y-2 text-sm leading-6 text-neutral-500">
					{service.data.focus.map((item: string) => (
						<li class="flex items-start gap-2">
							<span class="mt-0.5 font-monospace text-primary" aria-hidden="true">&raquo;</span>
							<span>{item}</span>
						</li>
					))}
				</ul>
			</section>
		)}

		{service.data.typicalWork?.length > 0 && (
			<section class="mt-10 reveal">
				<h2 class="text-base font-bold text-ink"><span class="mr-2 font-monospace text-xs text-primary">03</span>What that looks like</h2>
				<ul class="mt-2 space-y-2 text-sm leading-6 text-neutral-500">
					{service.data.typicalWork.map((item: string) => (
						<li class="flex items-start gap-2">
							<span class="mt-0.5 font-monospace text-primary" aria-hidden="true">&raquo;</span>
							<span>{item}</span>
						</li>
					))}
				</ul>
			</section>
		)}

		{service.data.deliverables?.length > 0 && (
			<section class="mt-10 reveal">
				<h2 class="text-base font-bold text-ink"><span class="mr-2 font-monospace text-xs text-primary">04</span>What you get</h2>
				<ul class="mt-2 space-y-2 text-sm leading-6 text-neutral-500">
					{service.data.deliverables.map((item: string) => (
						<li class="flex items-start gap-2">
							<span class="mt-0.5 font-monospace text-emerald-600" aria-hidden="true">[x]</span>
							<span>{item}</span>
						</li>
					))}
				</ul>
			</section>
		)}

		<footer class="mt-10 reveal">
			{service.data.tags?.length > 0 && (
				<div class="flex flex-wrap gap-2">
					{service.data.tags.map((tag: string) => (
						<Tag text={tag} />
					))}
				</div>
			)}

			<div class="mt-6 rounded-xl bg-white p-4 ring-soft ring-1 card-lift">
				<p class="font-monospace text-xs text-neutral-400" aria-hidden="true">$ cat /etc/expectations</p>
				<p class="mt-1 text-sm leading-6 text-neutral-500">No black boxes and no surprise invoices &mdash; you see the plan, the progress, and the root-cause story every step.</p>
			</div>

			<div class="mt-6 flex flex-wrap gap-3">
				<a
					href="/contact"
					class="group inline-flex items-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-sm font-semibold text-white transition duration-300 hover:bg-deep card-lift"
				>
					Let's talk about it
				</a>
				<a
					href="/services"
					class="group inline-flex items-center gap-2 rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-ink ring-1 ring-hard transition duration-300 hover:ring-primary/50"
				>
					<span class="transition-transform duration-300 group-hover:-translate-x-1" aria-hidden="true">&larr;</span>
					All services
				</a>
			</div>
		</footer>
	</main>
</Layout>
