---
import Sidebar from '@components/layout/Sidebar.astro';
import { SEO } from 'astro-seo';
import "@styles/global.css";
import '@fontsource/cal-sans';
import '@fontsource/inconsolata/400.css';
import '@fontsource/inconsolata/600.css';
import '@fontsource/inconsolata/700.css';

const SITE = 'https://saranshkawadkar.dev';
const SITE_NAME = 'Saransh Kawadkar - Software Engineer who ships';
const DEFAULT_DESCRIPTION =
	"Hi, I'm Saransh - a full-stack software engineer who turns messy ideas into fast, reliable software. Wander through my builds, what I can do for you, and - if you're feeling generous - a support page.";
const DEFAULT_OG_IMAGE = `${SITE}/og.jpg`;

export interface LayoutProps {
	title: string;
	description?: string;
	image?: string;
	type?: string;
}

const {
	title = 'Saransh Kawadkar - Software Engineer who ships',
	description = DEFAULT_DESCRIPTION,
	image = DEFAULT_OG_IMAGE,
	type = 'website',
} = Astro.props as LayoutProps;

const url = new URL(Astro.url.pathname, SITE).href;
const canonical = url.replace(/\/?$/, '/');
const ogImage = image.startsWith('http') ? image : new URL(image, SITE).href;
const ogTitle = title.trim();

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	'@id': `${SITE}/#person`,
	name: 'Saransh Kawadkar',
	url: SITE,
	image: `${SITE}/profile.jpg`,
	jobTitle: 'Software Engineer',
	description:
		'Full-stack software engineer building reliable web systems, developer tooling, and automation with React, Next.js, Node.js, TypeScript, Python, and C++.',
	email: 'mailto:saranshmm@gmail.com',
	sameAs: [
		'https://github.com/saransh-283',
		'https://www.linkedin.com/in/saransh-kawadkar',
		'https://www.instagram.com/sark283/',
		'https://t.me/SarK283',
		'https://www.fiverr.com/saranshkk',
	],
	address: { '@type': 'PostalAddress', addressCountry: 'IN' },
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	'@id': `${SITE}/#website`,
	url: SITE,
	name: SITE_NAME,
	description: DEFAULT_DESCRIPTION,
	publisher: { '@id': `${SITE}/#person` },
	inLanguage: 'en',
};

const breadcrumbs = Astro.url.pathname !== '/' && {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE }, { '@type': 'ListItem', position: 2, name: title, item: url }],
};

const schemas = [personSchema, websiteSchema, ...(breadcrumbs ? [breadcrumbs] : [])];
---

<!doctype html>
<html lang="en" class="scroll-smooth" data-testid="html">
	<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta http-equiv="X-UA-Compatible" content="IE=edge" />
	<meta name="generator" content={Astro.generator} />

	<script is:inline>
		(function () {
			var stored = null;
			try {
				stored = localStorage.getItem('theme');
			} catch (e) {}
			var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
			var root = document.documentElement;
			root.classList.toggle('dark', dark);
			root.style.colorScheme = dark ? 'dark' : 'light';
		})();
	</script>

		<SEO
			title={title}
			description={description}
			canonical={canonical}
			noindex={false}
			robotsExtras="max-image-preview:large, max-snippet:-1, max-video-preview:-1"
			openGraph={{
				basic: {
					type,
					title: ogTitle,
					image: ogImage,
					url: canonical,
				},
				optional: {
					description,
					locale: 'en_US',
					siteName: SITE_NAME,
				},
				image: {
					type: 'image/jpeg',
					width: 1200,
					height: 630,
					alt: `${ogTitle} - portfolio`,
				},
			}}
			twitter={{
				card: 'summary_large_image',
				site: '@saransh',
				creator: '@saransh',
				title,
				description,
				image: ogImage,
				imageAlt: `${ogTitle} - portfolio`,
			}}
		/>

		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link type="text/plain" rel="author" href="/llms.txt" />

		<meta name="keywords" content="Saransh Kawadkar, software engineer, full-stack, React, Next.js, TypeScript, C++, Qt, Python, Astro, portfolio" />
		<meta name="googlebot" content="index, follow" />
		<meta name="theme-color" content="#f0f3f9" />
		<meta name="author" content="Saransh Kawadkar" />
		<meta name="publisher" content="Saransh Kawadkar" />

		{schemas.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}
	</head>
	<body class="dot-grid bg-cream font-sans text-ink min-h-screen">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-white"
		>
			Skip to main content
		</a>
		<div class="flex min-h-screen items-stretch">
			<Sidebar />
			<div class="flex min-w-0 flex-1 flex-col">
				<main id="main-content" class="flex-1 px-6 py-10 sm:px-10 md:px-14 lg:pt-10 pt-16 lg:pb-10 pb-20" tabindex="-1">
					<slot />
				</main>
				<footer class="flex flex-col items-center justify-between gap-1 border-t border-neutral-200/70 px-6 py-4 text-xs text-neutral-400 font-monospace sm:flex-row sm:px-14">
					<span>&copy; 2026 Saransh Kawadkar</span>
					<span>&gt;&gt; made with <span class="text-primary">&hearts;</span> and slightly too many open tabs</span>
				</footer>
			</div>
		</div>
	</body>
</html>

<script>
	const revealTargets = document.querySelectorAll<HTMLElement>('.reveal');

	const show = (el: HTMLElement, delayMs = 0) => {
		el.style.setProperty('--reveal-delay', `${delayMs}ms`);
		el.classList.add('reveal-in');
		el.classList.remove('reveal-out');
		// Drop the stagger once it has played so hover transitions stay snappy.
		if (delayMs > 0) {
			window.setTimeout(() => {
				if (el.classList.contains('reveal-in')) el.style.setProperty('--reveal-delay', '0ms');
			}, delayMs + 600);
		}
	};

	const hide = (el: HTMLElement, exitedViaTop: boolean) => {
		// Leaving through the top of the viewport: slide back up and fade.
		// Leaving through the bottom (scrolled back up too far): slide back down and fade.
		el.style.setProperty('--reveal-delay', '0ms');
		el.classList.remove('reveal-in');
		el.classList.toggle('reveal-out', exitedViaTop);
	};

	document.querySelectorAll('a').forEach((a) => {
		const href = a.getAttribute('href') || '';
		if (!href.startsWith('/') && !href.startsWith('#') && !href.startsWith(window.location.origin)) {
			a.setAttribute('target', '_blank');
			a.setAttribute('rel', 'noopener noreferrer');
		}
	});

	if ('IntersectionObserver' in window) {
		let firstFrame = true;
		let firstBatchIndex = 0;

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					const el = entry.target as HTMLElement;

					if (entry.isIntersecting) {
						// Elements visible on first paint get a staggered entrance, like the homepage.
						show(el, firstFrame ? Math.min(firstBatchIndex++ * 70, 350) : 0);
					} else {
						const viewportMiddle = (entry.rootBounds?.top ?? 0) + (entry.rootBounds?.height ?? window.innerHeight) / 2;
						hide(el, entry.boundingClientRect.top < viewportMiddle);
					}
				}
				firstFrame = false;
			},
			{ rootMargin: '0px 0px -40px 0px', threshold: 0.05 }
		);

		revealTargets.forEach((el) => observer.observe(el));
	} else {
		revealTargets.forEach((el) => {
			el.classList.add('reveal-in');
		});
	}
</script>
