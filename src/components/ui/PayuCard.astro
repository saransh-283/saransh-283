---
interface PayuCardProps {
  id?: string;
}

import PayUIcon from '@icons/payu.astro';

const { id = 'payu' } = Astro.props as PayuCardProps;

const GENERIC_PAYU_LINK = 'https://u.payu.in/ArQ2xq2Vsbg6';

function detectCurrency(): string {
  return 'INR';
}
---

<div class="payu-card-wrapper" data-currency={detectCurrency()}>
  <div class="payu-card group relative rounded-xl bg-neutral-50 p-4 ring-1 ring-soft transition hover:bg-white hover:ring-primary/30 cursor-pointer pointer-events-auto" role="button" tabindex="0" aria-expanded="false" aria-controls="payu-collapse">
    <div class="flex items-center gap-4">
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white text-ink ring-1 ring-soft">
        <PayUIcon class="h-5 w-5" />
      </span>
      <span class="min-w-0">
        <span class="block font-semibold text-ink">PayU</span>
        <span class="block text-xs text-neutral-500">UPI / cards / netbanking - India (₹)</span>
      </span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="ml-auto h-5 w-5 fill-current transition-transform duration-300" id="payu-chevron"><path d="M7 10l5 5 5-5z"/></svg>
    </div>
  </div>

  <div id="payu-collapse" class="payu-collapse overflow-hidden max-h-0 transition-all duration-300 ease-out" role="region" aria-labelledby="payu-card-header">
    <div class="mt-3 pt-3 border-t border-neutral-200/70 space-y-3">
      <p class="text-xs text-neutral-500 font-monospace">Choose amount</p>

      <div class="flex flex-wrap gap-2 px-2 items-center" id="payu-fixed-amounts">
        <!-- Fixed amount buttons + custom amount button/field injected by JS -->
      </div>

      <button type="button" id="payu-pay-btn" class="w-full py-2.5 rounded-lg bg-primary text-white text-sm font-semibold hover:bg-primary/90 transition disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer" disabled>Pay</button>
      <p id="payu-msg" class="text-xs text-emerald-600 dark:text-emerald-400 min-h-[1.25rem]"></p>
    </div>
  </div>
</div>

<script>
  (function () {
    const CURRENCY_PRESETS: Record<string, { label: string; symbol: string; fixed: number[] }> = {
      INR: { label: '₹', symbol: '₹', fixed: [100, 500, 1000] },
      USD: { label: '$', symbol: '$', fixed: [5, 10, 25] },
      GBP: { label: '£', symbol: '£', fixed: [5, 10, 25] },
      EUR: { label: '€', symbol: '€', fixed: [10, 25, 50] },
    };

    function detectCurrency(): string | null {
      if (typeof navigator === 'undefined') return 'INR';
      try {
        const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
        if (tz.includes('Kolkata') || tz.includes('Asia/Kolkata')) return 'INR';
        if (tz.includes('London') || tz.includes('Europe/London')) return 'GBP';
        if (tz.includes('America/')) return 'USD';
        if (tz.includes('Europe/')) {
          const eurZones = ['Paris', 'Berlin', 'Rome', 'Amsterdam', 'Vienna', 'Brussels', 'Madrid', 'Dublin', 'Lisbon', 'Athens', 'Helsinki', 'Copenhagen', 'Oslo', 'Stockholm', 'Warsaw', 'Prague', 'Budapest'];
          if (eurZones.some((z) => tz.includes(z))) return 'EUR';
        }
      } catch {}
      const lang = navigator.language.toLowerCase();
      if (lang.includes('in')) return 'INR';
      if (lang.includes('gb')) return 'GBP';
      if (lang.includes('de') || lang.includes('fr') || lang.includes('es') || lang.includes('it') || lang.includes('nl') || lang.includes('pt')) return 'EUR';
      return null;
    }

    const wrapper = document.querySelector('.payu-card-wrapper');
    const card = document.querySelector('.payu-card');
    const collapse = document.getElementById('payu-collapse');
    const chevron = document.getElementById('payu-chevron');
    const fixedContainer = document.getElementById('payu-fixed-amounts');
    const payBtn = document.getElementById('payu-pay-btn');
    const msg = document.getElementById('payu-msg');

    if (!wrapper || !card || !collapse || !fixedContainer || !payBtn || !msg) return;

    let isOpen = false;
    let selectedAmount = null;
    let selectedCurrency = detectCurrency();
    wrapper.dataset.currency = selectedCurrency || '';
    let isCustom = false;

    const PRESETS = selectedCurrency && CURRENCY_PRESETS[selectedCurrency] ? CURRENCY_PRESETS[selectedCurrency] : null;

    if (!PRESETS) {
      // No supported currency match: clicking navigates directly to PayU
      chevron?.classList.add('rotate-270');
      card?.addEventListener('click', () => {
        window.location.href = 'https://u.payu.in/ArQ2xq2Vsbg6';
      });
      card?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          window.location.href = 'https://u.payu.in/ArQ2xq2Vsbg6';
        }
      });
      payBtn.disabled = true;
      payBtn.textContent = 'PayU not available';
      msg.textContent = 'PayU not supported for your region';
      return;
    }

    const currencySymbol = document.createElement('span');
    currencySymbol.id = 'payu-currency-symbol';
    currencySymbol.className = 'text-xs font-semibold text-neutral-600';
    currencySymbol.textContent = PRESETS.symbol;

    function renderFixed() {
      fixedContainer.innerHTML = '';

      PRESETS.fixed.forEach((amt) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = PRESETS.symbol + amt;
        btn.className = 'px-3 py-1.5 rounded-lg bg-white text-neutral-600 text-xs ring-1 ring-soft hover:bg-neutral-100 transition cursor-pointer';
        btn.dataset.amount = String(amt);
        btn.addEventListener('click', () => {
          selectAmount(amt, false);
        });
        fixedContainer.appendChild(btn);
      });

      // Custom amount button
      const customBtn = document.createElement('button');
      customBtn.type = 'button';
      customBtn.id = 'payu-custom-btn';
      customBtn.textContent = 'Custom';
      customBtn.className = 'px-3 py-1.5 rounded-lg bg-white text-neutral-600 text-xs ring-1 ring-soft hover:bg-neutral-100 transition cursor-pointer';
      customBtn.addEventListener('click', () => {
        if (isCustom) {
          selectAmount(null, false);
        } else {
          const customInput = document.getElementById('payu-custom-input');
          customWrap.classList.remove('hidden');
          customInput.focus();
          selectedAmount = null;
          isCustom = true;
          payBtn.disabled = true;
          payBtn.textContent = 'Pay';
          fixedContainer.querySelectorAll('button[data-amount]').forEach((b) => {
            b.className = 'px-3 py-1.5 rounded-lg bg-white text-neutral-600 text-xs ring-1 ring-soft hover:bg-neutral-100 transition';
          });
          customBtn.className = 'px-3 py-1.5 rounded-lg bg-white text-neutral-600 text-xs ring-1 ring-2 ring-primary transition';
        }
      });
      fixedContainer.appendChild(customBtn);

      // Custom amount input field (initially hidden)
      const customWrap = document.createElement('div');
      customWrap.id = 'payu-custom-wrap';
      customWrap.className = 'hidden flex items-center gap-2';
      customWrap.innerHTML = `
        <input type="number" id="payu-custom-input" placeholder="0" min="1" step="any" class="w-24 px-2 py-1.5 rounded-lg bg-white text-sm ring-1 ring-neutral-300 focus:ring-primary focus:border-primary outline-none" />
      `;
      fixedContainer.appendChild(customWrap);

      const customInput = document.getElementById('payu-custom-input');

      customInput.addEventListener('input', () => {
        const val = Number(customInput.value);
        if (val && val > 0 && val <= 100000) {
          selectAmount(val, true);
        } else {
          payBtn.disabled = true;
          const cb = document.getElementById('payu-custom-btn');
          if (cb) {
            cb.className = 'px-3 py-1.5 rounded-lg bg-white text-neutral-600 text-xs ring-1 ring-2 ring-primary transition';
          }
          fixedContainer.querySelectorAll('button[data-amount]').forEach((b) => {
            b.className = 'px-3 py-1.5 rounded-lg bg-white text-neutral-600 text-xs ring-1 ring-soft hover:bg-neutral-100 transition';
          });
        }
      });
    }

    function selectAmount(amt, custom) {
      selectedAmount = amt;
      isCustom = custom;

      if (!amt) {
        payBtn.disabled = true;
        payBtn.textContent = 'Pay';
        msg.textContent = '';
      } else {
        payBtn.disabled = false;
        payBtn.textContent = `Pay ${PRESETS.symbol}${amt}`;
        msg.textContent = '';
      }

      // Radio-button style: only the selected button gets a blue border
      fixedContainer.querySelectorAll('button[data-amount]').forEach((b) => {
        const isSelected = !custom && b.dataset.amount === String(amt);
        if (isSelected) {
          b.className = 'px-3 py-1.5 rounded-lg bg-white text-neutral-600 text-xs ring-1 ring-2 ring-primary transition cursor-pointer';
        } else {
          b.className = 'px-3 py-1.5 rounded-lg bg-white text-neutral-600 text-xs ring-1 ring-soft hover:bg-neutral-100 transition cursor-pointer';
        }
      });

      const cb = document.getElementById('payu-custom-btn');
      if (cb) {
        if (custom) {
          cb.className = 'px-3 py-1.5 rounded-lg bg-white text-neutral-600 text-xs ring-1 ring-2 ring-primary transition cursor-pointer';
        } else {
          cb.className = 'px-3 py-1.5 rounded-lg bg-white text-neutral-600 text-xs ring-1 ring-soft hover:bg-neutral-100 transition cursor-pointer';
        }
      }

      const cw = document.getElementById('payu-custom-wrap');
      if (cw) {
        if (custom) {
          cw.classList.remove('hidden');
        } else {
          cw.classList.add('hidden');
        }
      }
    }

    function toggle() {
      isOpen = !isOpen;
      card.setAttribute('aria-expanded', String(isOpen));
      if (isOpen) {
        collapse.style.maxHeight = collapse.scrollHeight + 'px';
        chevron.classList.add('rotate-180');
      } else {
        collapse.style.maxHeight = '0';
        chevron.classList.remove('rotate-180');
      }
    }

    card.addEventListener('click', toggle);
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle();
      }
    });

    renderFixed();

    payBtn.addEventListener('click', async () => {
      if (!selectedAmount) return;
      payBtn.disabled = true;
      payBtn.textContent = 'Creating order...';
      msg.textContent = '';

      try {
        const res = await fetch('/api/payu/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            amount: selectedAmount,
            currency: selectedCurrency,
            name: '',
            email: '',
            phone: '',
          }),
        });

        const data = await res.json();
        if (!res.ok || data.error) {
          throw new Error(data.error || 'Checkout failed');
        }

        // Auto-submit form to PayU
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = data.baseUrl + '/_payment';
        const fields = [
          'key', 'txnid', 'amount', 'productinfo', 'firstname', 'email', 'phone',
          'udf1', 'udf2', 'udf3', 'udf4', 'udf5', 'hash', 'surl', 'furl',
          'service_provider',
        ];
        fields.forEach((f) => {
          if (data[f] !== undefined) {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = f;
            input.value = data[f];
            form.appendChild(input);
          }
        });
        document.body.appendChild(form);
        form.submit();
      } catch (err) {
        payBtn.disabled = false;
        payBtn.textContent = 'Pay';
        msg.textContent = String(err.message || 'Something went wrong');
        msg.className = 'text-xs text-rose-600 dark:text-rose-400 min-h-[1.25rem]';
      }
    });
  })();
</script>

<style>
  .payu-collapse {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out;
  }
</style>
