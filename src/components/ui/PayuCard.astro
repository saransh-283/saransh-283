---
interface PayuCardProps {
  id?: string;
}

import PayUIcon from '@icons/payu.astro';

const { id = 'payu' } = Astro.props as PayuCardProps;

const CURRENCY_PRESETS: Record<string, { label: string; symbol: string; fixed: number[] }> = {
  INR: { label: '₹', symbol: '₹', fixed: [100, 500, 1000] },
  USD: { label: '$', symbol: '$', fixed: [5, 10, 25] },
  GBP: { label: '£', symbol: '£', fixed: [5, 10, 25] },
};

function detectCurrency(): string {
  if (typeof navigator === 'undefined') return 'INR';
  try {
    const resolved = Intl.NumberFormat(navigator.language).resolvedOptions();
    const cur = resolved.currency?.toUpperCase();
    if (cur && CURRENCY_PRESETS[cur]) return cur;
  } catch {}
  const lang = navigator.language.toLowerCase();
  if (lang.includes('in')) return 'INR';
  if (lang.includes('gb')) return 'GBP';
  return 'USD';
}
---

<div class="payu-card-wrapper" data-currency={detectCurrency()}>
  <section class="payu-card group relative rounded-xl bg-neutral-50 p-4 ring-1 ring-soft transition hover:bg-white hover:ring-primary/30 cursor-pointer" role="button" tabindex="0" aria-expanded="false" aria-controls="payu-collapse">
    <div class="flex items-center gap-4">
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white text-ink ring-1 ring-soft">
        <PayUIcon class="h-5 w-5" />
      </span>
      <span class="min-w-0">
        <span class="block font-semibold text-ink">PayU</span>
        <span class="block text-xs text-neutral-500">UPI / cards / netbanking - India (₹)</span>
      </span>
      <span class="ml-auto transition-transform duration-300" id="payu-chevron">▾</span>
    </div>
  </section>

  <div id="payu-collapse" class="payu-collapse overflow-hidden max-h-0 transition-all duration-300 ease-out" role="region" aria-labelledby="payu-card-header">
    <div class="mt-3 pt-3 border-t border-neutral-200/70 space-y-3">
      <p class="text-xs text-neutral-500 font-monospace">Choose amount</p>

      <div class="flex flex-wrap gap-2" id="payu-fixed-amounts">
        <!-- Fixed amount buttons injected by JS -->
      </div>

      <div class="flex items-center gap-2">
        <button type="button" id="payu-custom-btn" class="px-3 py-1.5 rounded-lg bg-white text-neutral-600 text-xs ring-1 ring-soft hover:bg-neutral-100 transition">Custom amount</button>
        <div id="payu-custom-wrap" class="hidden flex items-end gap-2">
          <input type="number" id="payu-custom-input" placeholder="0" min="1" step="any" class="w-24 px-2 py-1.5 rounded-lg bg-white text-sm ring-1 ring-neutral-300 focus:ring-primary focus:border-primary outline-none" />
          <span id="payu-currency-symbol" class="text-xs font-semibold text-neutral-600"></span>
        </div>
      </div>

      <button type="button" id="payu-pay-btn" class="w-full py-2.5 rounded-lg bg-primary text-white text-sm font-semibold hover:bg-primary/90 transition disabled:opacity-50 disabled:cursor-not-allowed">Pay</button>
      <p id="payu-msg" class="text-xs text-emerald-600 dark:text-emerald-400 min-h-[1.25rem]"></p>
    </div>
  </div>
</div>

<script>
  (function () {
    const wrapper = document.querySelector('.payu-card-wrapper');
    const card = document.querySelector('.payu-card');
    const collapse = document.getElementById('payu-collapse');
    const chevron = document.getElementById('payu-chevron');
    const fixedContainer = document.getElementById('payu-fixed-amounts');
    const customBtn = document.getElementById('payu-custom-btn');
    const customWrap = document.getElementById('payu-custom-wrap');
    const customInput = document.getElementById('payu-custom-input');
    const currencySymbol = document.getElementById('payu-currency-symbol');
    const payBtn = document.getElementById('payu-pay-btn');
    const msg = document.getElementById('payu-msg');

    if (!wrapper || !card || !collapse) return;

    let isOpen = false;
    let selectedAmount = null;
    let selectedCurrency = wrapper.dataset.currency || 'INR';
    let isCustom = false;

    const PRESETS = CURRENCY_PRESETS[selectedCurrency] || CURRENCY_PRESETS.INR;

    function renderFixed() {
      fixedContainer.innerHTML = '';
      PRESETS.fixed.forEach((amt) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = PRESETS.symbol + amt;
        btn.className = 'px-3 py-1.5 rounded-lg bg-white text-sm text-neutral-600 ring-1 ring-neutral-300 hover:bg-primary hover:text-white hover:ring-primary transition';
        btn.dataset.amount = String(amt);
        btn.addEventListener('click', () => {
          selectAmount(amt, false);
          fixedContainer.querySelectorAll('button').forEach((b) => {
            b.className = b.dataset.amount === String(amt)
              ? 'px-3 py-1.5 rounded-lg bg-primary text-white text-sm ring-1 ring-primary transition'
              : 'px-3 py-1.5 rounded-lg bg-white text-sm text-neutral-600 ring-1 ring-neutral-300 hover:bg-primary hover:text-white hover:ring-primary transition';
          });
        });
        fixedContainer.appendChild(btn);
      });
    }

    function selectAmount(amt, custom) {
      selectedAmount = amt;
      isCustom = custom;
      payBtn.disabled = false;
      payBtn.textContent = custom ? `Pay ${PRESETS.symbol}${amt}` : `Pay ${PRESETS.symbol}${amt}`;
      msg.textContent = '';
    }

    function toggle() {
      isOpen = !isOpen;
      card.setAttribute('aria-expanded', String(isOpen));
      if (isOpen) {
        collapse.style.maxHeight = collapse.scrollHeight + 'px';
        chevron.textContent = '▴';
      } else {
        collapse.style.maxHeight = '0';
        chevron.textContent = '▾';
      }
    }

    card.addEventListener('click', toggle);
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle();
      }
    });

    customBtn.addEventListener('click', () => {
      customWrap.classList.toggle('hidden');
      if (!customWrap.classList.contains('hidden')) {
        customInput.focus();
      }
    });

    customInput.addEventListener('input', () => {
      const val = Number(customInput.value);
      if (val && val > 0 && val <= 100000) {
        selectAmount(val, true);
      } else {
        payBtn.disabled = true;
      }
    });

    renderFixed();

    payBtn.addEventListener('click', async () => {
      if (!selectedAmount) return;
      payBtn.disabled = true;
      payBtn.textContent = 'Creating order...';
      msg.textContent = '';

      try {
        const res = await fetch('/api/payu/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            amount: selectedAmount,
            currency: selectedCurrency,
            name: '',
            email: '',
            phone: '',
          }),
        });

        const data = await res.json();
        if (!res.ok || data.error) {
          throw new Error(data.error || 'Checkout failed');
        }

        // Auto-submit form to PayU
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = data.baseUrl + '/_payment';
        const fields = [
          'key', 'txnid', 'amount', 'productinfo', 'firstname', 'email', 'phone',
          'udf1', 'udf2', 'udf3', 'udf4', 'udf5', 'hash', 'surl', 'furl',
          'service_provider',
        ];
        fields.forEach((f) => {
          if (data[f] !== undefined) {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = f;
            input.value = data[f];
            form.appendChild(input);
          }
        });
        document.body.appendChild(form);
        form.submit();
      } catch (err) {
        payBtn.disabled = false;
        payBtn.textContent = 'Pay';
        msg.textContent = String(err.message || 'Something went wrong');
        msg.className = 'text-xs text-rose-600 dark:text-rose-400 min-h-[1.25rem]';
      }
    });
  })();
</script>

<style>
  .payu-collapse {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out;
  }
</style>
