---
export type TerminalLine = { kind: 'cmd' | 'out'; text: string };

export type TerminalProps = {
	title?: string;
	lines?: TerminalLine[];
	cursor?: boolean;
	className?: string;
};

const { title = 'saransh@workstation ~ %', lines = [], cursor = false, className = '' } = Astro.props as TerminalProps;
---

<div class={`terminal ${className}`}>
	<div class="terminal-bar">
		<span class="h-3 w-3 rounded-full bg-red-400"></span>
		<span class="h-3 w-3 rounded-full bg-amber-300"></span>
		<span class="h-3 w-3 rounded-full bg-emerald-400"></span>
		<span class="ml-2 font-monospace text-xs text-[#8f97a5]">{title}</span>
	</div>
	<div class="terminal-body">
		{
			lines.map((line, i) => (
				<div class={i > 0 ? 'mt-2' : ''}>
					{line.kind === 'cmd' ? (
						<div>
							<span class="text-sky">$</span> <span class="text-sky">{line.text}</span>
							{cursor && i === lines.length - 1 && <span class="ml-1 animate-blink" aria-hidden="true">▌</span>}
						</div>
					) : (
						<div class="text-[#c8cdd6]">{line.text}</div>
					)}
				</div>
			))
		}
	</div>
</div>
