---
import Image from "@components/ui/Image.astro";
import Tag from "@components/ui/Tag.astro";
import ArrowRight from "@icons/arrow-right.astro";

export type ProjectRowData = {
	title: string;
	description: string;
	href: string;
	thumbnail?: string;
	tags: string[];
	inProgress?: boolean;
	delay?: number;
};

const { title, description, href, thumbnail, tags, inProgress = false, delay = 0 } = Astro.props as ProjectRowData;
---

<article
	class="reveal"
	style={`--reveal-delay: ${delay}s;`}
>
	<a href={href} class="group card-lift flex items-start gap-6 rounded-xl p-3 -m-3 transition-[background-color,transform] duration-300 hover:bg-neutral-100/60">
		<div class="relative h-30 w-30 shrink-0 overflow-hidden rounded-xl bg-neutral-100 ring-1 ring-soft">
			{thumbnail ? (
				<Image src={`${thumbnail}?raw=true`} alt={title} containerClass="h-full w-full" imgClass="object-cover transition-transform duration-500 group-hover:scale-105" />
			) : (
				<div class="h-full w-full" />
			)}
			{inProgress && (
				<span class="absolute left-2 top-2 rounded-full bg-amber-400/90 px-2 py-0.5 font-monospace text-[10px] font-semibold text-amber-900">WIP</span>
			)}
			<span class="pointer-events-none absolute inset-0 flex items-center justify-center rounded-xl bg-ink/60 opacity-0 backdrop-blur-[2px] transition-opacity duration-300 group-hover:opacity-100">
				<span class="rounded-lg bg-white px-3 py-1.5 text-xs font-semibold text-ink shadow">Open &rarr;</span>
			</span>
		</div>

		<div class="min-w-0">
			<div class="flex items-start justify-between gap-3">
				<div class="min-w-0">
					<h3 class="truncate font-semibold text-ink transition-colors duration-200 group-hover:text-deep">{title}</h3>
					<p class="mt-1 line-clamp-2 text-sm text-neutral-500">{description}</p>
				</div>
				<span class="mt-0.5 shrink-0 text-neutral-300 transition duration-300 group-hover:translate-x-1 group-hover:text-primary" aria-hidden="true">
					<ArrowRight className="h-5 w-5" />
				</span>
			</div>
			<div class="mt-3 flex flex-wrap gap-2">
				{tags.map((tag) => (
					<Tag text={tag} />
				))}
			</div>
		</div>
	</a>
</article>
