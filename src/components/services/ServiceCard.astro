---
import Image from "@components/ui/Image.astro";
import Tag from "@components/ui/Tag.astro";
import ArrowRight from "@icons/arrow-right.astro";

export type ServiceCardProps = {
	title: string;
	description: string;
	href: string;
	thumbnail?: string;
	tags?: string[];
	delay?: number;
};

const { title, description, href, thumbnail, tags, delay = 0 } = Astro.props as ServiceCardProps;
---

<article class="reveal" style={`--reveal-delay: ${delay}s;`}>
	<a href={href} class="group card-lift flex items-start gap-5 rounded-xl bg-neutral-50 p-4 ring-1 ring-soft transition duration-300 hover:bg-white hover:ring-primary/30 sm:p-5">
		{thumbnail && (
			<div class="hidden h-21 w-37.5 shrink-0 overflow-hidden rounded-lg ring-1 ring-soft sm:block">
				<Image src={/^https?:/.test(thumbnail) ? `${thumbnail}?raw=true` : thumbnail} alt={`${title} preview`} containerClass="h-full w-full" imgClass="object-cover transition-transform duration-500 group-hover:scale-105" />
			</div>
		)}
		<div class="min-w-0 flex-1">
			<div class="flex items-start justify-between gap-3">
				<h3 class="font-semibold text-ink transition-colors duration-200 group-hover:text-deep">{title}</h3>
				<span class="shrink-0 text-neutral-300 transition duration-300 group-hover:translate-x-1 group-hover:text-primary" aria-hidden="true">
					<ArrowRight className="h-5 w-5" />
				</span>
			</div>
			<p class="mt-1 text-sm leading-6 text-neutral-500">{description}</p>
			<div class="mt-3 flex flex-wrap gap-2">
				{tags?.map((tag) => (
					<Tag text={tag} />
				))}
			</div>
		</div>
	</a>
</article>
