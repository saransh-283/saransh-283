---
import GithubIcon from '@icons/github.astro';
import HeartIcon from '@icons/heart.astro';
import HouseIcon from '@icons/home.astro';
import LinkedinIcon from '@icons/linkedin.astro';
import FiverrIcon from '@icons/fiverr.astro';
import MailIcon from '@icons/email.astro';
import MoonIcon from '@icons/moon.astro';
import SunIcon from '@icons/sun.astro';
import FolderIcon from '@icons/briefcase.astro';
import WrenchIcon from '@icons/puzzle.astro';
import MessageIcon from '@icons/message.astro';

type NavItem = {
	label: string;
	path: string;
	href: string;
	icon?: any;
};

const pathname = Astro.url?.pathname ?? '/';

const navItems: NavItem[] = [
	{ label: 'home', path: '~/', href: '/', icon: HouseIcon },
	{ label: 'about', path: '~/about', href: '/about', icon: MessageIcon },
	{ label: 'projects', path: '~/projects', href: '/projects', icon: FolderIcon },
	{ label: 'services', path: '~/services', href: '/services', icon: WrenchIcon },
	{ label: 'contact', path: '~/contact', href: '/contact', icon: MailIcon },
];

const isActive = (href: string) => {
	if (href === '/') return pathname === '/';
	return pathname === href || pathname.startsWith(href + '/');
};
---

<div id="sidebar-backdrop" class="fixed inset-0 z-10 hidden bg-black/40 backdrop-blur-[2px] lg:hidden" aria-hidden="true"></div>

<aside
	id="sidebar"
	class="fixed bg-cream shadow-sm z-20 h-full w-1/2 transition-transform duration-300 ease-out top-0 left-0 -translate-x-full shrink-0 lg:sticky lg:top-0 lg:h-screen lg:w-auto lg:translate-x-0 lg:shadow-none lg:border-r lg:border-neutral-200/70 lg:z-0"
>
	<div class="flex h-full flex-col px-6 py-8 lg:overflow-y-auto custom-scrollbar">
		<div class="flex items-center gap-3 animate-fade-up">
			<img
				src="/profile.jpg"
				alt="Saransh Kawadkar profile photo"
				width="44"
				height="44"
				class="h-11 w-11 rounded-full object-cover ring-2 ring-primary/40"
				loading="eager"
			/>
			<div class="leading-tight">
				<div class="text-sm font-display font-semibold text-ink">Saransh Kawadkar</div>
				<div class="mt-0.5 flex items-center gap-1.5 text-xs font-monospace text-neutral-500">
					<span class="relative flex h-2 w-2">
						<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60" aria-hidden="true"></span>
						<span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
					</span>
					open to work
				</div>
			</div>
		</div>

		<nav class="mt-8" aria-label="Main navigation">
			<ul class="space-y-1">
				{navItems.map((item, i) => (
					<li style={`animation: fade-up .45s cubic-bezier(.22,1,.36,1) ${(0.05 * (i + 1)).toFixed(2)}s both;`}>
						<a
							href={item.href}
							aria-current={isActive(item.href) ? 'page' : undefined}
							class:list={[
								'group flex items-center gap-3 rounded-xl pl-3 pr-4 py-2 text-sm font-monospace transition-all duration-200',
								isActive(item.href)
									? 'bg-primary/10 font-semibold text-primary shadow-[inset_2px_0_0_0_var(--color-primary)]'
									: 'text-neutral-700 hover:bg-white hover:text-ink hover:pl-4',
							]}
						>
							{item.icon && <item.icon className={`h-4 w-4 ${isActive(item.href) ? 'text-primary' : 'text-neutral-400 group-hover:text-primary'} transition-colors duration-200`} />}
							<span>{item.path}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>

		<div class="mt-auto">
			<a
				href="/support"
				class="group card-lift flex items-center gap-3 rounded-xl bg-primary px-3 py-2.5 text-sm font-semibold text-white mb-6 hover:bg-deep"
			>
				<HeartIcon className="h-4 w-4 transition-transform duration-300 group-hover:scale-110" />
				<span data-testid="support-cta">Support me</span>
				<span class="ml-auto font-monospace text-xs opacity-80" aria-hidden="true">&hearts;</span>
			</a>

			<div class="flex items-center justify-between">
				<div class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Elsewhere</div>
				<button
					id="theme-toggle"
					type="button"
					class="theme-toggle rounded-lg p-1.5 text-neutral-500 ring-soft ring-1 transition hover:text-primary"
					aria-label="Toggle color theme"
					data-testid="theme-toggle"
				>
					<SunIcon className="icon-sun h-4 w-4" />
					<MoonIcon className="icon-moon h-4 w-4" />
				</button>
			</div>
			<ul class="mt-3 space-y-2 text-sm" aria-label="Social profiles">
				<li>
					<a
						class="group flex items-center gap-2 text-neutral-600 hover:text-ink transition-colors duration-200"
						href="https://github.com/saransh-283"
						target="_blank"
						rel="noopener"
					>
						<GithubIcon className="h-4 w-4 text-neutral-400 group-hover:text-primary transition-colors duration-200" />
						<span>Github</span>
					</a>
				</li>
				<li>
					<a
						class="group flex items-center gap-2 text-neutral-600 hover:text-ink transition-colors duration-200"
						href="https://www.linkedin.com/in/saransh-kawadkar"
						target="_blank"
						rel="noopener"
					>
						<LinkedinIcon className="h-4 w-4 text-neutral-400 group-hover:text-primary transition-colors duration-200" />
						<span>LinkedIn</span>
					</a>
				</li>
				<li>
					<a
						class="group flex items-center gap-2 text-neutral-600 hover:text-ink transition-colors duration-200"
						href="https://www.fiverr.com/saranshkk"
						target="_blank"
						rel="noopener"
					>
						<FiverrIcon className="h-4 w-4 text-neutral-400 group-hover:text-primary transition-colors duration-200" />
						<span>Fiverr</span>
					</a>
				</li>
			</ul>
			<div class="mt-6 font-monospace text-[10px] text-neutral-400">saranshkawadkar.dev &middot; built with Astro</div>
		</div>
	</div>
</aside>
<button
	id="sidebar-toggle"
	type="button"
	aria-label="Toggle navigation menu"
	aria-expanded="false"
	aria-controls="sidebar"
	class="sidebar-burger fixed right-4 top-4 z-30 h-10 w-10 cursor-pointer rounded-xl lg:hidden"
>
	<span class="toggle-bar" aria-hidden="true"></span>
	<span class="toggle-bar" aria-hidden="true"></span>
	<span class="toggle-bar" aria-hidden="true"></span>
</button>

<style>
	.sidebar-burger {
		backdrop-filter: blur(8px);
		background: var(--color-cream);
		border-radius: .75rem;
		border: 1px solid var(--hard);
		box-shadow: 0 2px 10px -2px #11182730;
		transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.sidebar-burger:active {
		transform: scale(0.92);
	}

	.toggle-bar {
		position: absolute;
		right: 9px;
		top: calc(50% - 1px);
		height: 2px;
		width: 22px;
		background: var(--color-ink);
		border-radius: 2px;
		transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.2s ease;
	}

	.toggle-bar:nth-of-type(1) {
		transform: translateY(-5px);
	}

	.toggle-bar:nth-of-type(3) {
		transform: translateY(5px);
	}

	#sidebar-toggle[aria-expanded='true'] .toggle-bar:nth-of-type(1) {
		transform: rotate(45deg);
	}

	#sidebar-toggle[aria-expanded='true'] .toggle-bar:nth-of-type(2) {
		opacity: 0;
	}

	#sidebar-toggle[aria-expanded='true'] .toggle-bar:nth-of-type(3) {
		transform: rotate(-45deg);
	}
</style>

<script>
	const toggle = document.getElementById('sidebar-toggle');
	const sidebar = document.getElementById('sidebar');
	const backdrop = document.getElementById('sidebar-backdrop');

	const openSidebar = () => {
		sidebar?.classList.remove('-translate-x-full');
		toggle?.setAttribute('aria-expanded', 'true');
		backdrop?.classList.remove('hidden');
	};

	const closeSidebar = () => {
		sidebar?.classList.add('-translate-x-full');
		toggle?.setAttribute('aria-expanded', 'false');
		backdrop?.classList.add('hidden');
	};

	toggle?.addEventListener('click', () => {
		if (sidebar?.classList.contains('-translate-x-full')) openSidebar();
		else closeSidebar();
	});

	backdrop?.addEventListener('click', closeSidebar);

	// Re-tapping the link of the page you're already on shouldn't be a full reload.
	document.querySelectorAll<HTMLAnchorElement>('#sidebar a[aria-current="page"]').forEach((link) => {
		link.addEventListener('click', (e) => {
			e.preventDefault();
			closeSidebar();
		});
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closeSidebar();
	});

	const themeToggle = document.getElementById('theme-toggle');
	themeToggle?.addEventListener('click', () => {
		const root = document.documentElement;
		root.classList.add('theme-anim');
		const isDark = root.classList.toggle('dark');
		root.style.colorScheme = isDark ? 'dark' : 'light';
		localStorage.setItem('theme', isDark ? 'dark' : 'light');
		setTimeout(() => root.classList.remove('theme-anim'), 500);
	});
</script>
