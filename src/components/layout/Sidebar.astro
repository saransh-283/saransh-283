---
import { Icon } from 'astro-icon/components';

type NavItem = {
	label: string;
	path: string;
	href: string;
	icon?: string;
};

const pathname = Astro.url?.pathname ?? '/';

const navItems: NavItem[] = [
	{ label: 'home', path: '~/', href: '/', icon: 'mdi:home' },
	{ label: 'about', path: '~/about', href: '/about', icon: 'mdi:message' },
	{ label: 'projects', path: '~/projects', href: '/projects', icon: 'mdi:briefcase' },
	{ label: 'services', path: '~/services', href: '/services', icon: 'mdi:puzzle' },
	{ label: 'contact', path: '~/contact', href: '/contact', icon: 'mdi:email' },
];

const isActive = (href: string) => {
	if (href === '/') return pathname === '/';
	return pathname === href || pathname.startsWith(href + '/');
};
---

<!-- Desktop sidebar -->
<aside
	id="sidebar"
	class="hidden lg:block lg:sticky lg:top-0 lg:h-screen lg:w-auto lg:z-0 lg:border-r lg:border-neutral-200/70"
>
	<div class="flex h-full flex-col px-6 py-8 lg:overflow-y-auto custom-scrollbar">
		<div class="flex items-center gap-3 animate-fade-up">
			<img
				src="/profile.jpg"
				alt="Saransh Kawadkar profile photo"
				width="44"
				height="44"
				class="h-11 w-11 rounded-full object-cover ring-2 ring-primary/40"
				loading="eager"
			/>
			<div class="leading-tight">
				<div class="text-sm font-display font-semibold text-ink">Saransh Kawadkar</div>
				<div class="mt-0.5 flex items-center gap-1.5 text-xs font-monospace text-neutral-500">
					<span class="relative flex h-2 w-2">
						<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60" aria-hidden="true"></span>
						<span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
					</span>
					open to work
				</div>
			</div>
		</div>

		<nav class="mt-8" aria-label="Main navigation">
			<ul class="space-y-1">
				{navItems.map((item, i) => (
					<li style={`animation: fade-up .45s cubic-bezier(.22,1,.36,1) ${(0.05 * (i + 1)).toFixed(2)}s both;`}>
						<a
							href={item.href}
							aria-current={isActive(item.href) ? 'page' : undefined}
							class:list={[
								'group flex items-center gap-3 rounded-xl pl-3 pr-4 py-2 text-sm font-monospace transition-all duration-200',
								isActive(item.href)
									? 'bg-primary/10 font-semibold text-primary shadow-[inset_2px_0_0_0_var(--color-primary)]'
									: 'text-neutral-700 hover:bg-white hover:text-ink hover:pl-4',
							]}
						>
							{item.icon && <Icon name={item.icon} class={`h-4 w-4 ${isActive(item.href) ? 'text-primary' : 'text-neutral-400 group-hover:text-primary'} transition-colors duration-200`} />}
							<span>{item.path}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>

		<div class="mt-auto">
			<a
				href="/support"
				class="group card-lift flex items-center gap-3 rounded-xl bg-primary px-3 py-2.5 text-sm font-semibold text-white mb-6 hover:bg-deep"
			>
				<Icon name="mdi:heart" class="h-4 w-4 transition-transform duration-300 group-hover:scale-110" />
				<span data-testid="support-cta">Support me</span>
				<span class="ml-auto font-monospace text-xs opacity-80" aria-hidden="true">&hearts;</span>
			</a>

			<div class="flex items-center justify-between">
				<div class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Elsewhere</div>
				<button
					id="theme-toggle"
					type="button"
					class="theme-toggle rounded-lg p-1.5 text-neutral-500 ring-soft ring-1 transition hover:text-primary cursor-pointer"
					aria-label="Toggle color theme"
					data-testid="theme-toggle"
				>
					<Icon name="mdi:weather-sunny" class="icon-sun h-4 w-4" />
					<Icon name="mdi:moon-waxing-crescent" class="icon-moon h-4 w-4" />
				</button>
			</div>
			<ul class="mt-3 space-y-2 text-sm" aria-label="Social profiles">
				<li>
					<a
						class="group flex items-center gap-2 text-neutral-600 hover:text-ink transition-colors duration-200"
						href="https://github.com/saransh-283"
						target="_blank"
						rel="noopener"
					>
						<Icon name="mdi:github" class="h-4 w-4 text-neutral-400 group-hover:text-primary transition-colors duration-200" />
						<span>Github</span>
					</a>
				</li>
				<li>
					<a
						class="group flex items-center gap-2 text-neutral-600 hover:text-ink transition-colors duration-200"
						href="https://www.linkedin.com/in/saransh-kawadkar"
						target="_blank"
						rel="noopener"
					>
						<Icon name="mdi:linkedin" class="h-4 w-4 text-neutral-400 group-hover:text-primary transition-colors duration-200" />
						<span>LinkedIn</span>
					</a>
				</li>
				<li>
					<a
						class="group flex items-center gap-2 text-neutral-600 hover:text-ink transition-colors duration-200"
						href="https://www.fiverr.com/saranshkk"
						target="_blank"
						rel="noopener"
					>
						<Icon name="simple-icons:fiverr" class="h-4 w-4 text-neutral-400 group-hover:text-primary transition-colors duration-200" />
						<span>Fiverr</span>
					</a>
				</li>
			</ul>
			<div class="mt-6 font-monospace text-[10px] text-neutral-400">saranshkawadkar.dev &middot; built with Astro</div>
		</div>
	</div>
</aside>

<!-- Mobile top sticky bar -->
<header class="lg:hidden fixed top-0 left-0 right-0 z-40 h-14 flex items-center justify-between px-4 bg-white/5 dark:bg-ink/5 backdrop-blur-md">
	<div class="flex items-center gap-3">
		<img
			src="/profile.jpg"
			alt="Saransh Kawadkar profile photo"
			width="36"
			height="36"
			class="h-9 w-9 rounded-full object-cover ring-2 ring-primary/30"
			loading="eager"
		/>
		<div class="leading-tight">
			<div class="text-xs font-display font-semibold text-ink">Saransh Kawadkar</div>
			<div class="mt-0.5 flex items-center gap-1.5 text-[10px] font-monospace text-neutral-500">
				<span class="relative flex h-1.5 w-1.5">
					<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60" aria-hidden="true"></span>
					<span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
				</span>
				open to work
			</div>
		</div>
	</div>

	<div class="flex items-center gap-2">
		<button id="theme-toggle-mobile" type="button" class="theme-toggle rounded-lg p-2 text-neutral-500 ring-soft ring-1 transition hover:text-primary hover:bg-white/60 cursor-pointer" aria-label="Toggle color theme" data-testid="theme-toggle">
			<Icon name="mdi:weather-sunny" class="icon-sun h-4 w-4" />
			<Icon name="mdi:moon-waxing-crescent" class="icon-moon h-4 w-4" />
		</button>
		<div class="relative">
			<button id="mobile-elsewhere-btn" type="button" class="rounded-lg p-2 text-neutral-600 hover:text-ink hover:bg-white/60 transition flex items-center gap-1 cursor-pointer" aria-label="Elsewhere links">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5 fill-current transition-transform duration-300" id="elsewhere-caret"><path d="M7 10l5 5 5-5z"/></svg>
			</button>
			<div id="mobile-elsewhere-dropdown" class="absolute right-0 top-full mt-2 w-40 rounded-xl bg-white shadow-xl border border-neutral-200/60 overflow-hidden origin-top scale-y-0 opacity-0 transition-all duration-300">
				<a href="https://github.com/saransh-283" target="_blank" rel="noopener" class="flex items-center gap-2 px-3 py-2 text-xs font-monospace text-neutral-700 hover:bg-primary/10 hover:text-ink"><Icon name="mdi:github" class="h-3.5 w-3.5" /> Github</a>
				<a href="https://www.linkedin.com/in/saransh-kawadkar" target="_blank" rel="noopener" class="flex items-center gap-2 px-3 py-2 text-xs font-monospace text-neutral-700 hover:bg-primary/10 hover:text-ink"><Icon name="mdi:linkedin" class="h-3.5 w-3.5" /> LinkedIn</a>
				<a href="https://www.fiverr.com/saranshkk" target="_blank" rel="noopener" class="flex items-center gap-2 px-3 py-2 text-xs font-monospace text-neutral-700 hover:bg-primary/10 hover:text-ink"><Icon name="simple-icons:fiverr" class="h-3.5 w-3.5" /> Fiverr</a>
			</div>
		</div>
	</div>
</header>

<!-- Mobile bottom pill nav -->
<nav class="lg:hidden fixed bottom-4 left-1/2 -translate-x-1/2 z-40" aria-label="Mobile navigation">
	<div class="flex items-center gap-4 rounded-full bg-white/5 dark:bg-ink/5 backdrop-blur-md px-4 py-2.5">
		{[
			{ href: '/', label: 'home', icon: 'mdi:home' },
			{ href: '/about', label: 'about', icon: 'mdi:message' },
			{ href: '/projects', label: 'projects', icon: 'mdi:briefcase' },
			{ href: '/services', label: 'services', icon: 'mdi:puzzle' },
			{ href: '/contact', label: 'contact', icon: 'mdi:email' },
			{ href: '/support', label: 'support', icon: 'mdi:heart' },
		].map((item) => (
			<a href={item.href} aria-label={item.label} class="group relative flex h-11 w-11 items-center justify-center rounded-full transition hover:bg-white/70" aria-current={isActive(item.href) ? 'page' : undefined}>
				<Icon name={item.icon} class={`h-5 w-5 transition-colors duration-200 ${isActive(item.href) ? 'text-primary' : 'text-neutral-500 group-hover:text-ink'}`} />
				<span class="absolute -top-8 left-1/2 -translate-x-1/2 rounded-md bg-ink px-2.5 py-0.5 text-[10px] font-monospace text-white opacity-0 translate-y-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-y-0 whitespace-nowrap pointer-events-none z-50">{item.label}</span>
			</a>
		))}
	</div>
</nav>

<style>
	.icon-sun { display: none; }
	.dark .icon-sun { display: block; }
	.dark .icon-moon { display: none; }
</style>

<script>
	const themeToggleDesktop = document.getElementById('theme-toggle');
	themeToggleDesktop?.addEventListener('click', () => {
		const root = document.documentElement;
		root.classList.add('theme-anim');
		const isDark = root.classList.toggle('dark');
		root.style.colorScheme = isDark ? 'dark' : 'light';
		localStorage.setItem('theme', isDark ? 'dark' : 'light');
		setTimeout(() => root.classList.remove('theme-anim'), 500);
	});

	const themeToggleMobile = document.getElementById('theme-toggle-mobile');
	themeToggleMobile?.addEventListener('click', () => {
		const root = document.documentElement;
		root.classList.add('theme-anim');
		const isDark = root.classList.toggle('dark');
		root.style.colorScheme = isDark ? 'dark' : 'light';
		localStorage.setItem('theme', isDark ? 'dark' : 'light');
		setTimeout(() => root.classList.remove('theme-anim'), 500);
	});

	const btn = document.getElementById('mobile-elsewhere-btn');
	const dropdown = document.getElementById('mobile-elsewhere-dropdown');
	const caret = document.getElementById('elsewhere-caret');
	btn?.addEventListener('click', () => {
		const open = dropdown?.classList.contains('scale-y-0');
		if (open) {
			dropdown?.classList.remove('scale-y-0', 'opacity-0');
			dropdown?.classList.add('scale-y-100', 'opacity-100');
			caret?.classList.add('rotate-180');
		} else {
			dropdown?.classList.add('scale-y-0', 'opacity-0');
			dropdown?.classList.remove('scale-y-100', 'opacity-100');
			caret?.classList.remove('rotate-180');
		}
	});
	document.addEventListener('click', (e) => {
		if (!btn?.contains(e.target as Node) && !dropdown?.contains(e.target as Node)) {
			dropdown?.classList.add('scale-y-0', 'opacity-0');
			dropdown?.classList.remove('scale-y-100', 'opacity-100');
			caret?.classList.remove('rotate-180');
		}
	});
</script>
